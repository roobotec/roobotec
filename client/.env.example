# Security warning:
# Do not expose a live Gemini API key in public client code.
# Keep the key in a secure server-side place if possible; for this static React frontend,
# the key must be injected locally via an environment variable only.
REACT_APP_GEMINI_API_KEY=replace_with_your_gemini_api_key
REACT_APP_GEMINI_MODEL=gemini-3.6-flash
